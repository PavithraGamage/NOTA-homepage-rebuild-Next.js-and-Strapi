# Copy to .env.local for local development. On Railway these are service variables
# (see .railway/railway.ts and docs/architecture.md). None of these reach the browser.

# Strapi over the private network. On Railway: http://${{cms.RAILWAY_PRIVATE_DOMAIN}}:${{cms.PORT}}
STRAPI_INTERNAL_URL=http://localhost:1337
# Strapi's public origin for media URLs. On Railway: https://${{cms.RAILWAY_PUBLIC_DOMAIN}}
STRAPI_PUBLIC_URL=http://localhost:1337
# Strapi admin → Settings → API Tokens. Read-only token for published content.
STRAPI_READ_TOKEN=
# Create-only token for waitlist entries (Phase 5).
# STRAPI_FORM_TOKEN=

# Shared with the CMS webhook (same value as apps/cms REVALIDATE_SECRET). On Railway: ${{shared.REVALIDATE_SECRET}}
REVALIDATE_SECRET=

# Public URL of this site.
SITE_URL=http://localhost:3000

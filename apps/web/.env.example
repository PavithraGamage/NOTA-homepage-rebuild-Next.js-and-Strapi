# Copy to .env.local for local development. On Netlify these are site variables (Site
# configuration → Environment variables); see README → Hosting. None of these reach the browser.

# Strapi as this server reaches it. On Netlify: the CMS's public URL, e.g. https://nota-cms.onrender.com
# (on Railway it was the private network: http://${{cms.RAILWAY_PRIVATE_DOMAIN}}:${{cms.PORT}})
STRAPI_INTERNAL_URL=http://localhost:1337
# Strapi's public origin. On Netlify: the same URL as above.
STRAPI_PUBLIC_URL=http://localhost:1337
# Only when uploads live in object storage: the bucket's public address (the CMS's S3_PUBLIC_URL),
# read at build time for next/image. Leave unset locally.
# MEDIA_PUBLIC_URL=
# Strapi admin → Settings → API Tokens. Read-only token for published content.
STRAPI_READ_TOKEN=
# Create-only token for the waitlist form (Custom token, permission: Waitlist-signup → create).
STRAPI_FORM_TOKEN=

# End-to-end tests only (not used by the site): find + delete on Waitlist-signup, so the tests can
# check and clean up what they store. Locally: cd apps/cms && npm run --silent create-token -- e2e
# E2E_STRAPI_TOKEN=

# Shared with the CMS webhook: the same value as REVALIDATE_SECRET on the CMS (apps/cms/.env, or Render).
REVALIDATE_SECRET=

# Public URL of this site.
SITE_URL=http://localhost:3000

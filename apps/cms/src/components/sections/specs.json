{
  "collectionName": "components_sections_specss",
  "info": {
    "displayName": "Specifications",
    "icon": "bulletList",
    "description": "Pen specifications in three groups."
  },
  "options": {},
  "attributes": {
    "anchorId": {
      "type": "string",
      "maxLength": 40,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "isHidden": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "headingMuted": {
      "type": "string",
      "required": true,
      "maxLength": 24
    },
    "heading": {
      "type": "string",
      "required": true,
      "maxLength": 32
    },
    "penImage": {
      "type": "component",
      "repeatable": false,
      "component": "shared.responsive-image",
      "required": true
    },
    "groups": {
      "type": "component",
      "repeatable": true,
      "component": "elements.spec-group",
      "min": 1,
      "max": 3
    }
  }
}

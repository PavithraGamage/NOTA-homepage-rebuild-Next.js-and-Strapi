# Copy to .env for local development. On Railway these are service variables
# (see .railway/railway.ts and docs/architecture.md).

# Server. On Railway: HOST=:: (IPv6 + IPv4 for private networking), PORT=1337 set explicitly.
HOST=0.0.0.0
PORT=1337
# Public origin of the CMS (admin + absolute media URLs). On Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
PUBLIC_URL=http://localhost:1337
# Trust X-Forwarded-* from Railway's edge proxy. true on Railway, false locally.
TRUST_PROXY=false

# Secrets. Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Database (docker compose locally; ${{Postgres.DATABASE_URL}} on Railway, which is the private URL)
DATABASE_URL=postgres://strapi:strapi@127.0.0.1:5432/nota_cms
DATABASE_SSL=false

# Optional: store uploads in S3-compatible object storage instead of public/uploads (needed on hosts
# without a persistent disk, such as Render's free plan). Leave S3_BUCKET empty to keep local files.
# Neon Object Storage: the bucket must be created as public_read; the endpoint and region come from
# the Neon console or API, and the key pair from `neon credentials create --scope storage:read
# --scope storage:write`. Once the site's URL is known, run `npm run storage:cors` to let only the
# site read the bucket from the browser (a new Neon bucket lets every website read).
S3_BUCKET=
# e.g. https://br-xxxx.storage.c-1.ap-southeast-1.aws.neon.tech
S3_ENDPOINT=
# e.g. ap-southeast-1
S3_REGION=
# The endpoint followed by /<bucket>: the public address of the files
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ROOT_PATH=nota

# Browsers allowed to call the API (the web app's public origin)
CORS_ORIGINS=http://localhost:3000

# On-demand revalidation webhook, provisioned at startup by src/bootstrap/revalidate-webhook.ts.
# Leave empty to skip (e.g. when the web app isn't running locally).
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Shared with the web app. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=change-me-to-a-long-random-string
